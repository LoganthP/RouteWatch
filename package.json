{
  "name": "routewatch",
  "private": true,
  "version": "2.0.0",
  "description": "RouteWatch — AI-enabled geospatial traffic incident analytics (MongoDB + Express + React + Python ML)",
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node scripts/dev.js",
    "dev:all": "node scripts/dev-all.js",
    "seed": "npm --prefix backend run seed",
    "backfill": "npm --prefix backend run backfill",
    "benchmark": "npm --prefix backend run benchmark",
    "test": "npm --prefix backend run test:api",
    "test:api": "npm --prefix backend run test:api",
    "test:e2e": "npm --prefix e2e test",
    "test:all": "node backend/scripts/api-test.js && npm --prefix e2e test",
    "test:ml": "node scripts/ml-test.js",
    "verify:sidebar": "node scripts/verify-sidebar.js",
    "benchmark:baseline": "node scripts/benchmark-baseline.js",
    "benchmark:pages": "node scripts/measure-page-performance.js",
    "check": "node scripts/check.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
