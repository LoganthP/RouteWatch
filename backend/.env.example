# ---- core ----
PORT=5000
# Local / Docker:  mongodb://127.0.0.1:27017/routewatch_db
# Atlas:           mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/routewatch_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/routewatch_db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=10d
CLIENT_ORIGIN=http://localhost:5173
# Live-update (Socket.IO) origins: * = any (default), or a comma-separated list
SOCKET_CORS_ORIGINS=*

# ---- files (outside app/ so auto-reload never restarts the server) ----
UPLOAD_DIR=.data
MODEL_DIR=models

# ---- dataset upload ----
MAX_UPLOAD_MB=4096
MAX_ZIP_ENTRIES=50
MAX_UNCOMPRESSED_MB=8192
MAX_IMPORT_ROWS_ADMIN=500000
MAX_IMPORT_ROWS_CITIZEN=500
# Excel, JSON, GeoJSON, KML, GPX and PDF are read as a whole; bigger files must be converted to CSV
MAX_INMEMORY_MB=200
UPLOAD_INIT_RATE_LIMIT=200

# ---- storage guard (Default: 1024 MB / 1 GB; automatically caps at 512 MB for MongoDB Atlas M0). 0 disables ----
STORAGE_QUOTA_MB=1024
DB_QUOTA_MB=1024

# ---- ML Service ----
ML_SERVICE_URL=http://127.0.0.1:8000

# ---- address geocoding for rows without coordinates (OpenStreetMap Nominatim, 1 request/second) ----
GEOCODE_ENABLED=true
GEOCODE_MAX_PER_IMPORT=200
GEOCODE_EMAIL=
